<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="areacheckPU" transaction-type="JTA">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>
        <class>com.example.areacheck.entities.ResultEntity</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- УДАЛИТЕ или ЗАКОММЕНТИРУЙTE эту строку -->
            <!-- <property name="eclipselink.target-database" value="H2"/> -->

            <!-- Используйте полное имя класса если нужно -->
            <property name="eclipselink.target-database"
                      value="org.eclipse.persistence.platform.database.H2Platform"/>

            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>

            <!-- Создание таблиц -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>

            <!-- Отключаем валидацию для тестирования -->
            <property name="jakarta.persistence.validation.mode" value="NONE"/>
        </properties>
    </persistence-unit>

</persistence>